# =============================================================================
# PRISM - OSINT Platform
# Unified Dockerfile for Render.com deployment
#
# Includes:
#   - Main SpiderFoot/PRISM web app  (CherryPy, port 10000)
#   - Embedded Sandbox analysis      (Chromium + Selenium, no Docker-in-Docker)
#
# On Render, Docker-in-Docker is not available.
# The sandbox runs runner.py directly as a subprocess inside this container.
# Set SANDBOX_MODE=native (already set below) to enable this behaviour.
# =============================================================================

FROM python:3.11-slim

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=10000 \
    SPIDERFOOT_DATA=/var/lib/prism \
    SPIDERFOOT_CACHE=/var/lib/prism/cache \
    # Sandbox runs natively (no Docker-in-Docker) inside this container
    SANDBOX_MODE=native \
    SANDBOX_RUNNER_PATH=/app/sandbox/runner.py \
    SANDBOX_OUT_DIR=/var/lib/prism/sandbox_out \
    # Chromium flags used by runner.py (headless, no sandbox needed inside container)
    CHROMIUM_FLAGS="--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu"

WORKDIR /app

# ---------------------------------------------------------------------------
# System dependencies
#   - gcc / libffi / libssl  → Python C-extension builds
#   - curl                   → health check
#   - chromium + chromedriver → sandbox URL analysis (native mode)
#   - fonts-liberation + x11 libs → Chromium rendering
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    gcc \
    libffi-dev \
    libssl-dev \
    curl \
    # Chromium browser + driver for sandbox
    chromium \
    chromium-driver \
    # Fonts & Chromium runtime libraries
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python dependencies
#   Layer 1: main app requirements
#   Layer 2: sandbox requirements (selenium, webdriver-manager)
# ---------------------------------------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY sandbox/requirements.txt ./sandbox-requirements.txt
RUN pip install --no-cache-dir -r sandbox-requirements.txt

# ---------------------------------------------------------------------------
# Application code
# ---------------------------------------------------------------------------
COPY . .

# Copy sandbox runner into predictable location
# (already in ./sandbox/runner.py but make it explicit)
RUN mkdir -p /app/sandbox

# ---------------------------------------------------------------------------
# Data & output directories
# ---------------------------------------------------------------------------
RUN mkdir -p /var/lib/prism/cache \
             /var/lib/prism/sandbox_out \
             /app/sandbox_out \
    && chmod -R 777 /var/lib/prism \
    && chmod -R 777 /app/sandbox_out

# ---------------------------------------------------------------------------
# Entrypoint script
# Sets up chromium binary path detection, then starts PRISM
# ---------------------------------------------------------------------------
RUN printf '#!/bin/bash\n\
set -e\n\
\n\
echo "=== PRISM OSINT Platform ==="\n\
echo "Port          : ${PORT:-10000}"\n\
echo "Sandbox mode  : ${SANDBOX_MODE}"\n\
\n\
# Detect chromium binary (varies by Debian version)\n\
for CANDIDATE in /usr/bin/chromium /usr/bin/chromium-browser /usr/bin/google-chrome; do\n\
    if [ -x "$CANDIDATE" ]; then\n\
        export CHROMIUM_BINARY="$CANDIDATE"\n\
        echo "Chromium binary: $CHROMIUM_BINARY"\n\
        break\n\
    fi\n\
done\n\
\n\
# Detect chromedriver\n\
for CANDIDATE in /usr/bin/chromedriver /usr/lib/chromium/chromedriver /usr/lib/chromium-browser/chromedriver; do\n\
    if [ -x "$CANDIDATE" ]; then\n\
        export CHROMEDRIVER_PATH="$CANDIDATE"\n\
        echo "Chromedriver   : $CHROMEDRIVER_PATH"\n\
        break\n\
    fi\n\
done\n\
\n\
# Ensure sandbox output directory is writable\n\
mkdir -p "${SANDBOX_OUT_DIR:-/var/lib/prism/sandbox_out}"\n\
mkdir -p /app/sandbox_out\n\
\n\
exec python3 sf.py -l "0.0.0.0:${PORT:-10000}"\n\
' > /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

# ---------------------------------------------------------------------------
# Port & health check
# ---------------------------------------------------------------------------
EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:${PORT:-10000}/ || exit 1

# ---------------------------------------------------------------------------
# Start
# ---------------------------------------------------------------------------
CMD ["/app/docker-entrypoint.sh"]
