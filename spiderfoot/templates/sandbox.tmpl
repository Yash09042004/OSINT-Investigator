<%include file="HEADER.tmpl"/>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="glyphicon glyphicon-eye-open"></i> Safe Link Analysis Sandbox</h2>
            <p>Analyze suspicious URLs safely in an isolated container. This tool captures screenshots and console logs without exposing your host machine.</p>
            
            <!-- Input Form -->
            <div class="well">
                <form id="sandbox-form">
                    <div class="form-group">
                        <label for="url-input">Enter URL to Analyze:</label>
                        <input type="text" class="form-control" id="url-input" placeholder="https://example.com" autocomplete="off">
                    </div>
                    <button type="submit" id="analyze-btn" class="btn btn-primary">
                        <i class="glyphicon glyphicon-search"></i> Analyze
                    </button>
                </form>
            </div>

            <!-- Loader -->
            <div id="loader" class="alert alert-info" style="display: none;">
                <i class="glyphicon glyphicon-refresh glyphicon-spin"></i> Analyzing URL in isolated container... This may take 30-60 seconds.
            </div>

            <!-- Results Area -->
            <div id="results-area" style="display: none;">
                <h3>Analysis Results</h3>
                <div class="panel panel-default">
                    <ul class="nav nav-tabs">
                        <li class="active"><a data-toggle="tab" href="#tab-screenshot">Screenshots</a></li>
                        <li><a data-toggle="tab" href="#tab-logs">Console Logs</a></li>
                    </ul>

                    <div class="tab-content" style="padding-top: 20px;">
                        <div id="tab-screenshot" class="tab-pane fade in active">
                             <div id="screenshots-container"></div>
                             <div id="no-screenshot" class="alert alert-warning" style="display:none">No screenshots available.</div>
                        </div>
                        <div id="tab-logs" class="tab-pane fade">
                            <pre id="log-output" style="height: 500px; overflow-y: scroll; background: #222; color: #0f0;"></pre>
                             <div id="no-logs" class="alert alert-warning" style="display:none">No logs available.</div>
                        </div>
                    </div>
                </div>
            </div>
        
            <div id="error-area" class="alert alert-danger" style="display: none;"></div>

        </div>
    </div>
</div>

<script>
    $("#sandbox-form").submit(function(e) {
        e.preventDefault();
        var url = $("#url-input").val();
        
        if (!url) {
            alertify.error("Please enter a URL");
            return;
        }

        // Show loader, hide previous results
        $("#loader").show();
        $("#results-area").hide();
        $("#error-area").hide();
        $("#analyze-btn").prop("disabled", true);

        $.ajax({
            type: "POST",
            url: "${docroot}/sandboxscan",
            data: { url: url },
            success: function(data) {
                $("#loader").hide();
                $("#analyze-btn").prop("disabled", false);

                if (data.status === "error") {
                    $("#error-area").text(data.message).show();
                    return;
                }

                $("#results-area").show();
                var scanId = data.scan_id;

                // Try to load screenshots.json manifest
                $.ajax({
                    url: "${docroot}/sandboxfile?id=" + scanId + "&file=screenshots.json",
                    dataType: "json",
                    success: function(manifest) {
                        // Display all screenshots from manifest
                        if (manifest.screenshots && manifest.screenshots.length > 0) {
                            var html = '<div class="row">';
                            manifest.screenshots.forEach(function(screenshot) {
                                html += '<div class="col-md-6" style="margin-bottom: 20px;">';
                                html += '  <div class="thumbnail">';
                                html += '    <img src="${docroot}/sandboxfile?id=' + scanId + '&file=' + screenshot.filename + '" class="img-responsive" style="width: 100%;">';
                                html += '    <div class="caption">';
                                html += '      <h5><strong>Page ' + screenshot.number + ':</strong> ' + (screenshot.type === 'homepage' ? 'Homepage' : 'Internal Page') + '</h5>';
                                html += '      <p style="font-size: 11px; word-break: break-all; color: #666;">' + screenshot.url + '</p>';
                                html += '    </div>';
                                html += '  </div>';
                                html += '</div>';
                            });
                            html += '</div>';
                            html += '<p class="text-muted"><small>Total screenshots captured: ' + manifest.total_screenshots + '</small></p>';
                            $("#screenshots-container").html(html);
                            $("#no-screenshot").hide();
                        } else {
                            $("#no-screenshot").show();
                        }
                    },
                    error: function() {
                        // Fallback to single screenshot if manifest doesn't exist
                        if (data.has_screenshot) {
                            var html = '<img src="${docroot}/sandboxfile?id=' + scanId + '&file=screenshot.png" class="img-responsive img-thumbnail" style="border: 1px solid #ddd; width: 100%;">';
                            $("#screenshots-container").html(html);
                            $("#no-screenshot").hide();
                        } else {
                            $("#no-screenshot").show();
                        }
                    }
                });

                // Load logs
                if (data.has_logs) {
                    $.ajax({
                        url: "${docroot}/sandboxfile?id=" + scanId + "&file=console.json",
                        dataType: "json",
                        success: function(logs) {
                            var logText = JSON.stringify(logs, null, 2);
                            $("#log-output").text(logText);
                            $("#no-logs").hide();
                        },
                        error: function() {
                            $("#no-logs").show();
                        }
                    });
                } else {
                    $("#no-logs").show();
                }
            },
            error: function(xhr, status, error) {
                $("#loader").hide();
                $("#analyze-btn").prop("disabled", false);
                $("#error-area").text("Server error: " + error).show();
            }
        });
    });
</script>

<%include file="FOOTER.tmpl"/>
